# Modelo do arquivo .env — o instalar.bat cria o .env a partir dele.
# Para configurar à mão: copie para ".env" (na mesma pasta) e preencha.

# --- Modo do site -------------------------------------------------------
# No seu computador deixe como está. No site publicado (PythonAnywhere):
#   DJANGO_DEBUG=0
#   DJANGO_ALLOWED_HOSTS=seunome.pythonanywhere.com
#   DJANGO_SECRET_KEY=<gere com o comando que está no DEPLOY.md>
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=
DJANGO_SECRET_KEY=

# --- Banco --------------------------------------------------------------
# mysql  = servidor MySQL (dados abaixo)
# sqlite = arquivo contratempo/contratempo.sqlite3, sem servidor
DB_ENGINE=mysql
DB_NAME=contratempo_db
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# --- E-mail (Gmail) -----------------------------------------------------
# Use uma SENHA DE APP (myaccount.google.com/apppasswords, exige
# verificação em duas etapas), não a senha normal da conta.
# Deixe vazio para os e-mails aparecerem no terminal do runserver.
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# --- E-mail pelo Brevo (necessário no PythonAnywhere grátis) -------------
# No PythonAnywhere grátis o Gmail recusa o login vindo do servidor.
# Com esta chave, os e-mails saem pelo Brevo (brevo.com, 300/dia grátis).
# O remetente é o EMAIL_HOST_USER acima, que precisa estar confirmado no
# Brevo. A senha do Gmail deixa de ser usada. Deixe vazio no seu PC.
BREVO_API_KEY=
